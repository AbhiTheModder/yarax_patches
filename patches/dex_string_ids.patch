+    /// Collects string identifier items (offsets into the string data
+    /// section) from the string_ids_off table.
+    ///
+    /// See: https://source.android.com/docs/core/runtime/dex-format#string-id-item
+    fn parse_string_ids(
+        data: &[u8],
+        header: &DexHeader,
+    ) -> Vec<protos::dex::StringId> {
+        if header.string_ids_off == 0 {
+            return Vec::new();
+        }
+
+        let table_slice = match data.get(header.string_ids_off as usize..) {
+            Some(slice) => slice,
+            None => return Vec::new(),
+        };
+
+        iterator(table_slice, le_u32::<&[u8], Error>)
+            .take(Self::MAX_STRINGS)
+            .take(header.string_ids_size as usize)
+            .map(|offset| {
+                let mut item = protos::dex::StringId::new();
+                item.set_offset(offset);
+                item
+            })
+            .collect()
+    }
